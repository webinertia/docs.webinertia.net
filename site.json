{
    "$schema": "https://raw.githubusercontent.com/webinertia/asciidoc-php-multi-repo/1.0.x/config/site.schema.json",
    "schemaVersion": 1,
    "site": {
        "name": "Webware Documentation",
        "baseUrl": "https://docs.webinertia.net/",
        "basePath": "/",
        "hostname": "docs.webinertia.net"
    },
    "organization": {
        "name": "webinertia",
        "propertyName": "doc-target",
        "onboardValue": "true",
        "tokenEnvVar": "DOC_DISCOVERY_TOKEN"
    },
    "source": {
        "directory": "docs"
    },
    "render": {
        "safeMode": "safe"
    },
    "projects": {
        "message-bus": {
            "title": "message-bus",
            "description": "MessageBus for Mezzio",
            "accent": "#0f766e"
        },
        "messagebus-event": {
            "title": "messagebus-event",
            "description": "Phly EventDispatcher support for MessageBus",
            "accent": "#7e5ae0"
        }
    },
    "output": {
        "directory": "build/docs",
        "cacheDirectory": "build/docs-cache",
        "reportPath": "build/docs-report.json"
    }
}
